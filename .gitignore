settings.json
settings.json.*
launcher-settings.json
launcher-settings.json.*
.env
.env.*
!.env.example

# Runtime logs and crash dumps
*.log
*.log.*
*.dmp

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
