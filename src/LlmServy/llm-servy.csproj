<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>llm-servy</AssemblyName>
    <RootNamespace>LlmServy</RootNamespace>
    <Product>LLM Servy</Product>
    <Title>LLM Servy</Title>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../../assets/llm-servy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 LLM Servy contributors</Copyright>
    <Description>Windows llama.cpp launcher with WSL harness support</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/llm-servy.ico" LogicalName="LlmServy.AppIcon.ico" />
    <InternalsVisibleTo Include="LlmServy.Tests" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../wsl/pi-bridge.sh" Link="wsl/pi-bridge.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../wsl/pi-supervisor.py" Link="wsl/pi-supervisor.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../wsl/wsl-bridge.sh" Link="wsl/wsl-bridge.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../wsl/wsl-supervisor.py" Link="wsl/wsl-supervisor.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
